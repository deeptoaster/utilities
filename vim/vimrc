function AddAlignment()
  let l:begin = search('\$\$', 'bcnW')
  let l:end = search('\$\$', 'nW')
  if l:begin != 0 && l:end != 0
    execute l:begin . 'substitute/\$\$/\\begin{align*}/'
    execute l:end . 'substitute/\$\$/\\end{align*}/'
    if l:end - l:begin >= 2
      execute (l:begin + 1) . ',' . (l:end - 1) .
          \ 'substitute/\v:?\=|\<\>|\\[gln]e|\\approx|\\in|\\propto|\\sim|\\subset(eq)?/\&\0/'
    endif
    if l:end - l:begin >= 3
      execute (l:begin + 1) . ',' . (l:end - 2) . 'substitute/$/ \\\\/'
    endif
  endif
endfunction
function s:BufClean()
  for l:bufnr in range(1, bufnr('$'))
    if buflisted(l:bufnr) && empty(win_findbuf(l:bufnr))
      execute 'bdelete!' l:bufnr
    endif
  endfor
endfunction
function CopilotChatToggle()
  let l:winnr = bufwinnr(g:copilot_chat_active_buffer)
  if l:winnr != -1
    execute l:winnr 'close'
  else
    let l:curwinid = win_getid()
    for l:winid in win_findbuf(g:copilot_chat_active_buffer)
      call win_gotoid(l:winid)
      close
    endfor
    call win_gotoid(l:curwinid)
    CopilotChatToggle
    normal G
    startinsert
  endif
endfunction
function DetailHoverCodeAction()
  if !empty(ale#util#FindItemAtCursor(bufnr())[1])
    ALEDetail
  else
    ALEHover
    ALECodeAction
  endif
endfunction
function DiffDisk()
  vertical new
  setlocal bufhidden=wipe
  setlocal buftype=nofile
  read ++edit #
  1delete _
  diffthis
  wincmd p
  diffthis
endfunction
function DrawerFind()
  let l:bufnr = bufnr()
  let l:curwinid = win_getid()
  if !g:NERDTree.IsOpen()
    call s:DrawerOpen()
  endif
  execute l:bufnr 'bufdo NERDTreeFind'
  if !empty(FugitiveGitDir(l:bufnr))
    wincmd j
    execute 'buffer' l:bufnr
    Gedit :
    normal zR
  endif
  call win_gotoid(l:curwinid)
endfunction
function s:DrawerOpen()
  let l:bufnr = bufnr()
  NERDTreeFocus
  if !empty(FugitiveGitDir(l:bufnr))
    execute 'belowright sbuffer' l:bufnr
    Gedit :
    normal zR
  endif
endfunction
function DrawerToggle()
  let l:curwinid = win_getid()
  if g:NERDTree.IsOpen()
    NERDTreeClose
    call s:FugitiveCloseTabIndices()
  else
    call s:DrawerOpen()
  endif
  call win_gotoid(l:curwinid)
endfunction
function s:FugitiveCloseIndices()
  for l:bufnr in range(1, bufnr('$'))
    if getbufvar(l:bufnr, 'fugitive_type') ==# 'index'
      execute 'bdelete' l:bufnr
    endif
  endfor
endfunction
function s:FugitiveCloseTabIndices()
  for l:winnr in range(1, winnr('$'))
    let l:bufnr = winbufnr(l:winnr)
    if getbufvar(l:bufnr, 'fugitive_type') ==# 'index'
      execute 'bdelete' l:bufnr
    endif
  endfor
endfunction
function GoToDefinition()
  try
    execute "normal! \<C-]>"
  catch
    ALEGoToDefinition
  endtry
endfunction
function GoToTerminal()
  for l:winnr in range(1, winnr('$'))
    if getbufvar(winbufnr(l:winnr), '&buftype') ==# 'terminal'
      execute l:winnr 'wincmd w'
      return
    endif
  endfor
endfunction
function s:Hover(line, column)
  let l:bufnr = bufnr()
  let b:ale_set_balloons = 0
  call timer_start(
    \ 600,
    \ {-> setbufvar(l:bufnr, 'ale_set_balloons', g:ale_set_balloons)}
  \ )
  call ale#hover#Show(
    \ l:bufnr,
    \ a:line,
    \ a:column,
    \ {'called_from_balloonexpr': v:true}
  \ )
endfunction
function HoverFunctionCall()
  let l:curpos = getpos('.')
  let [l:line, l:column] = searchpos('(', 'bcnW')
  if l:line == l:curpos[1] && l:column == l:curpos[2] - 1
    call s:Hover(l:line, l:column)
  else
    let &operatorfunc = function('s:HoverOperator', [winsaveview()])
    normal g@[(
  endif
endfunction
function s:HoverOneBack()
  if !empty(v:completed_item)
    let l:curpos = getpos('.')
    call s:Hover(l:curpos[1], l:curpos[2] - 1)
  endif
endfunction
function s:HoverOperator(view, type)
  call winrestview(a:view)
  let l:operatorpos = getpos("'[")
  call s:Hover(l:operatorpos[1], l:operatorpos[2])
endfunction
function s:PandocPdfAppendMessage(bufnr, _channel, data, ...)
  let l:pandoc_pdf_messages = getbufvar(a:bufnr, 'pandoc_pdf_messages', v:null)
  if l:pandoc_pdf_messages is v:null
    return
  endif
  call timer_stop(getbufvar(a:bufnr, 'pandoc_pdf_timer', 0))
  if has('nvim')
    if a:data !=# ['']
      if empty(l:pandoc_pdf_messages)
        call add(l:pandoc_pdf_messages, {'text': ''})
      endif
      let l:pandoc_pdf_messages[-1].text .= a:data[0]
      call extend(
        \ l:pandoc_pdf_messages,
        \ map(a:data[1:], {_index, message -> {'text': message}})
      \ )
    endif
  else
    call add(l:pandoc_pdf_messages, {'text': a:data})
  endif
  call setbufvar(
    \ a:bufnr,
    \ 'pandoc_pdf_timer',
    \ timer_start(600, function('s:PandocPdfEchoMessages', [a:bufnr]))
  \ )
endfunction
function s:PandocPdfBuild()
  let l:bufnr = bufnr()
  let l:command = ['pandoc', '-o', b:pandoc_pdf_target, expand('%:t')]
  let l:options = {'cwd': expand('%:h')}
  if has('nvim')
    let l:options.on_exit = function('s:PandocPdfOpen', [l:bufnr])
    let l:options.on_stderr = function('s:PandocPdfAppendMessage', [l:bufnr])
    call jobstart(l:command, l:options)
  else
    let l:options.err_cb = function('s:PandocPdfAppendMessage', [l:bufnr])
    let l:options.exit_cb = function('s:PandocPdfOpen', [l:bufnr])
    call job_start(l:command, l:options)
  endif
endfunction
function s:PandocPdfEchoMessages(bufnr, _timer)
  let l:pandoc_pdf_messages = getbufvar(a:bufnr, 'pandoc_pdf_messages')
  call setqflist(l:pandoc_pdf_messages)
  if !empty(l:pandoc_pdf_messages)
    call s:QuickFixOpen()
  endif
  call setbufvar(a:bufnr, 'pandoc_pdf_messages', [])
endfunction
function s:PandocPdfOpen(bufnr, _job, status, ...)
  if a:status != 0 || getbufvar(a:bufnr, 'pandoc_pdf_viewed', 1)
    return
  endif
  call setbufvar(a:bufnr, 'pandoc_pdf_viewed', 1)
  let l:command = [
    \ executable('zathura') ? 'zathura' : 'open',
    \ getbufvar(a:bufnr, 'pandoc_pdf_target')
  \ ]
  call setbufvar(
    \ a:bufnr,
    \ 'pandoc_pdf_viewer',
    \ has('nvim') ? jobstart(l:command) : job_start(l:command)
  \ )
endfunction
function PandocPdfToggle()
  if !exists('b:pandoc_pdf_messages')
    let b:ale_fix_on_save = 0
    let b:pandoc_pdf_messages = []
    let b:pandoc_pdf_target = '/tmp/' . expand('%:t:r') . '.pdf'
    let b:pandoc_pdf_viewed = 0
    augroup squiffles
      autocmd BufWritePost <buffer> call s:PandocPdfBuild()
    augroup end
    write
  else
    augroup squiffles
      autocmd! BufWritePost <buffer>
    augroup end
    call timer_stop(get(b:, 'pandoc_pdf_timer', 0))
    unlet! b:pandoc_pdf_timer
    if exists('b:pandoc_pdf_viewer')
      if has('nvim')
        call jobstop(b:pandoc_pdf_viewer)
      else
        call job_stop(b:pandoc_pdf_viewer)
      endif
      unlet b:pandoc_pdf_viewer
    endif
    unlet b:ale_fix_on_save b:pandoc_pdf_messages b:pandoc_pdf_target b:pandoc_pdf_viewed
    cclose
  endif
endfunction
function s:PandocPreviewRefresh()
  let l:preview_bufnr = get(b:, 'pandoc_preview_bufnr', -1)
  if !bufexists(l:preview_bufnr)
    return
  endif
  let l:raw_lines = systemlist(
    \ 'COLUMNS=' . winwidth(win_findbuf(l:preview_bufnr)[0]) . ' pandoc --to='
    \ . expand('~/.lua/scripts/terminal.lua') . ' 2> /dev/null',
    \ getline(1, '$')
  \ )
  let l:lines = map(
    \ l:raw_lines,
    \ {_index, line -> substitute(line, '\e\[[0-9;]*m', '', 'g')}
  \ )
  let l:linecount = getbufinfo(l:preview_bufnr)[0].linecount
  call setbufvar(l:preview_bufnr, '&modifiable', 1)
  call setbufline(l:preview_bufnr, 1, l:lines)
  if len(l:lines) < l:linecount
    call deletebufline(l:preview_bufnr, len(l:lines) + 1, l:linecount)
  endif
  call setbufvar(l:preview_bufnr, '&modifiable', 0)
  call setbufvar(l:preview_bufnr, '&modified', 0)
endfunction
function PandocPreviewToggle()
  let l:preview_bufnr = get(b:, 'pandoc_preview_bufnr', -1)
  unlet! b:pandoc_preview_bufnr
  setlocal noscrollbind
  if bufexists(l:preview_bufnr)
    execute 'bdelete' l:preview_bufnr
    return
  endif
  rightbelow vertical new
  setlocal bufhidden=wipe
  setlocal buftype=nofile
  setlocal nonumber
  setlocal scrollbind
  setlocal signcolumn=no
  let l:preview_bufnr = bufnr()
  wincmd p
  let b:pandoc_preview_bufnr = l:preview_bufnr
  setlocal scrollbind
  call s:PandocPreviewRefresh()
  syncbind
endfunction
function s:Persist()
  if !empty(v:this_session) && !exists('g:SessionLoad')
    silent! execute 'mksession!' v:this_session
  endif
endfunction
function s:PersistAndCloseTerminals()
  if !empty(v:this_session) && empty(filter(range(1, bufnr('$')), {
    \ _index, bufnr ->
        \ getbufvar(bufnr, '&modified') &&
        \ getbufvar(bufnr, '&buftype') !=# 'terminal'
  \ }))
    augroup squiffles
      autocmd! BufEnter *
    augroup end
    call s:FugitiveCloseIndices()
    execute 'mksession!' v:this_session
    if !has('nvim')
      for l:bufnr in range(1, bufnr('$'))
        if getbufvar(l:bufnr, '&buftype') ==# 'terminal'
          call term_sendkeys(l:bufnr, "\<C-D>")
        endif
      endfor
      sleep 100m
      for l:bufnr in range(1, bufnr('$'))
        if stridx(term_getstatus(l:bufnr), 'running') != -1
          execute 'bdelete!' l:bufnr
        endif
      endfor
    endif
  endif
endfunction
function QuickFixDifferentFile(operator)
  let l:qflist = getqflist({'id': 0, 'idx': 0, 'items': [], 'size': 0})
  let l:current = l:qflist.idx - 1
  let l:bufnr = l:qflist.items[l:current].bufnr
  for l:delta in range(1, l:qflist.size - 1)
    let l:other =
        \ (a:operator(l:current, l:delta) + l:qflist.size) % l:qflist.size
    if l:qflist.items[l:other].bufnr != l:bufnr
      execute 'cc' l:other + 1
      return
    endif
  endfor
endfunction
function s:QuickFixOpen()
  let l:curwinid = win_getid()
  cclose
  wincmd b
  vertical rightbelow copen 80
  call win_gotoid(l:curwinid)
endfunction
function QuickFixToggle()
  for l:winnr in range(1, winnr('$'))
    if getbufvar(winbufnr(l:winnr), '&buftype') ==# 'quickfix'
      cclose
      return
    endif
  endfor
  call s:QuickFixOpen()
endfunction
function s:ReopenTerminals(_timer)
  let l:curwinid = win_getid()
  for l:bufnr in range(1, bufnr('$'))
    if getbufvar(l:bufnr, '&buftype') ==# 'terminal' ||
        \ bufname(l:bufnr)[0:6] ==# 'term://'
      for l:bufwinid in win_findbuf(l:bufnr)
        call win_gotoid(l:bufwinid)
        if has('nvim')
          terminal
        else
          enew!
          terminal ++curwin
        endif
      endfor
    endif
  endfor
  call win_gotoid(l:curwinid)
  call s:BufClean()
endfunction
function s:RestoreLayout()
  call s:FugitiveCloseIndices()
  call timer_stop(get(s:, 'terminals_timer', 0))
  let s:terminals_timer = timer_start(200, function('s:ReopenTerminals'))
  if !empty(v:this_session)
    call rename(v:this_session, v:this_session . '~')
  endif
endfunction
augroup squiffles
  autocmd!
  autocmd BufEnter * call s:Persist()
  autocmd BufWritePost * call s:PandocPreviewRefresh()
  autocmd CompleteDone * call s:HoverOneBack()
  autocmd ExitPre * call s:PersistAndCloseTerminals()
  autocmd FileType markdown noremap <buffer> <Leader>ll <Cmd>call PandocPdfToggle()<CR>
  autocmd FileType markdown noremap <buffer> <Leader>lp <Cmd>call PandocPreviewToggle()<CR>
  autocmd FileType php setlocal foldmethod=indent
  autocmd FileType python setlocal foldmethod=indent
  autocmd SessionLoadPost * call s:RestoreLayout()
  if has('nvim')
    autocmd TermOpen * setlocal nonumber nospell
  endif
augroup end
